{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "enabledManagers": [
    "custom.regex",
    "flux",
    "github-actions",
    "nix",
    "npm",
    "terraform"
  ],

  "flux": {
    "managerFilePatterns": [
      "/^platform\\/gitops\\/.+\\.ya?ml$/",
      "/^platform\\/networking\\/cni\\/.+\\.ya?ml$/"
    ]
  },

  "ignorePaths": [".opencode/**"],

  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)infrastructure/opentofu/stacks/prod/proxmox/main\\.tf$/",
        "/(^|/)infrastructure/opentofu/stacks/prod/talos/config\\.ya?ml$/"
      ],
      "matchStrings": [
        "version\\s*=\\s*\"(?<currentValue>v[^\"]+)\"",
        "talos_version:\\s*(?<currentValue>v[^\"\\s]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)infrastructure/opentofu/stacks/prod/talos/config\\.ya?ml$/"
      ],
      "matchStrings": ["kubernetes_version:\\s*(?<currentValue>v[^\"\\s]+)"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],

  "packageRules": [
    {
      "description": "Auto-merge low-risk patch updates after CI passes",
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Require manual review for OpenTofu provider updates",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "automerge": false
    },
    {
      "description": "Group Flux system manifest updates",
      "matchManagers": ["flux"],
      "matchFileNames": ["platform/gitops/gotk-components.yaml"],
      "groupName": "flux system",
      "automerge": false
    },
    {
      "description": "Require manual review for Talos Linux version updates",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["siderolabs/talos"],
      "automerge": false,
      "groupName": "talos linux"
    },
    {
      "description": "Group Nix flake updates",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Require manual review for minor updates",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
