{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "enabledManagers": ["custom.regex", "github-actions", "nix", "terraform"],

  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)infrastructure/opentofu/.*\\.tf$/"],
      "matchStrings": ["talos_version\\s*=\\s*\"v(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],

  "packageRules": [
    {
      "description": "Auto-merge low-risk patch updates after CI passes",
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Require manual review for OpenTofu provider updates",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "automerge": false
    },
    {
      "description": "Require manual review for Talos Linux version updates",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["siderolabs/talos"],
      "automerge": false,
      "groupName": "talos linux"
    },
    {
      "description": "Group Nix flake updates",
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Require manual review for minor updates",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
