[Container]
Image=ghcr.io/dani-garcia/vaultwarden@sha256:1ca2e2098ba9ab9e46004f4ee61a3be6080ffee3ed41018a95c4b0fb6454a54b

EnvironmentFile=./vaultwarden.env

Network=host

Volume=/var/lib/app-data/vaultwarden:/data:Z

[Service]
MemoryMax=512M
TasksMax=1024
LimitNOFILE=262144
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
