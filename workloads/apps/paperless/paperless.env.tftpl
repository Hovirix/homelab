# --------------------------------------------------
# Required services
# --------------------------------------------------

# Redis broker
PAPERLESS_REDIS=redis://valkey.internal.home.hovirix.dev:6379/1

# Database
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=<hostname>
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=<database>
PAPERLESS_DBUSER=<username>
PAPERLESS_DBPASS=<password>

# --------------------------------------------------
# Hosting & Security
# --------------------------------------------------

PAPERLESS_SECRET_KEY=<secret>

# Authentication & SSO
PAPERLESS_SOCIALACCOUNT_PROVIDERS=${PAPERLESS_SOCIALACCOUNT_PROVIDERS}
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
PAPERLESS_DISABLE_REGULAR_LOGIN=true
PAPERLESS_REDIRECT_LOGIN_TO_SSO=true

# --------------------------------------------------
# Software tweaks
# --------------------------------------------------

PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
