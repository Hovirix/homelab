[Container]
Image=ghcr.io/paperless-ngx/paperless-ngx@sha256:7b937cb2fa2885ab0ecfceb8c7e8827e2312472d9d897a270097ba7f5522dcdc

EnvironmentFile=./paperless.env

Network=host

Volume=/var/lib/app-data/paperless/data:/usr/src/paperless/data:Z
Volume=/var/lib/app-data/paperless/media:/usr/src/paperless/media:Z
Volume=/var/lib/app-data/paperless/export:/usr/src/paperless/export:Z
Volume=/var/lib/app-data/paperless/consume:/usr/src/paperless/consume:Z

[Service]
MemoryMax=2G
TasksMax=2048
LimitNOFILE=262144
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
