{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Hovirix Homelab",
  "description": "Official documentation for the Hovirix Homelab infrastructure, services, automation, and deployment guides.",

  "colors": {
    "primary": "#fe640b",
    "light": "#fe640b",
    "dark": "#fe640b"
  },

  "logo": {
    "light": "/public/logo/light.svg",
    "dark": "/public/logo/dark.svg"
  },

  "favicon": {
    "light": "public/favicon/favicon.svg",
    "dark": "public/favicon/favicon.svg"
  },

  "appearance": {
    "default": "system",
    "strict": false
  },

  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/Hovirix/homelab"
    }
  },

  "navigation": {
    "groups": [
      {
        "group": "About",
        "pages": [
          "about/welcome",
          "about/quickstart",
          "about/development"
        ]
      },
      {
        "group": "Architecture & Operations",
        "pages": [
          "architecture/overview",
          "architecture/infrastructure",
          "architecture/networking",
          "architecture/iam",
          "architecture/provisioning",
          "architecture/services",
          "architecture/storage",
          "architecture/observability",
          "architecture/security",
          "architecture/backup-dr",
          "architecture/change-management",
          "architecture/automation",
          "architecture/runbooks",
          "architecture/roadmap"
        ]
      }
    ]
  },

  "footer": {
    "socials": {
      "github": "https://github.com/Hovirix",
      "website": "https://hovirix.com"
    }
  }
}
