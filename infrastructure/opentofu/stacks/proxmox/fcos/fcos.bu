variant: fcos
version: 1.7.0

passwd:
  users:
    - name: admin
      groups:
        - wheel
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPTAawDXqCZS9g+Q+2/L8chJ5gD97WLaKKi6DG4nccuA openpgp:0x3602CA24

    - name: deploy
      groups:
        - docker
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPTAawDXqCZS9g+Q+2/L8chJ5gD97WLaKKi6DG4nccuA openpgp:0x3602CA24

storage:
  files:
    - path: /etc/tmpfiles.d/swarm.conf
      mode: 0644
      contents:
        inline: |
          d /var/mnt/swarm/traefik           0777 :root :root -
          d /var/mnt/swarm/postgres          0777 :root :root -
          d /var/mnt/swarm/valkey            0777 :root :root -
          d /var/mnt/swarm/grafana           0777 :root :root -
          d /var/mnt/swarm/victoriametrics   0777 :root :root -
          d /var/mnt/swarm/loki              0777 :root :root -
          d /var/mnt/swarm/vaultwarden       0777 :root :root -

          d /var/mnt/swarm/paperless         0755 :root :root -
          d /var/mnt/swarm/paperless/data    0777 :root :root -
          d /var/mnt/swarm/paperless/media   0777 :root :root -
          d /var/mnt/swarm/paperless/export  0777 :root :root -
          d /var/mnt/swarm/paperless/consume 0777 :root :root -

    - path: /etc/selinux/local/container-host-access.cil
      mode: 0644
      contents:
        inline: |
          (allow container_t container_var_run_t (sock_file (getattr open read write ioctl lock append)))
          (allow container_t container_runtime_t (unix_stream_socket (connectto)))
          (allow container_t var_log_t (dir (getattr search open read watch watch_reads)))
          (allow container_t var_log_t (file (getattr open read map)))
          (allow container_t syslogd_var_run_t (dir (getattr search open read watch watch_reads)))
          (allow container_t syslogd_var_run_t (file (getattr open read map)))
          (allow container_t cgroup_t (dir (getattr search open read watch watch_mount watch_sb watch_with_perm watch_reads)))
          (allow container_t init_t (file (getattr open read)))
          (allow container_t proc_t (dir (getattr search open read)))
          (allow container_t proc_t (file (getattr open read)))
          (allow container_t proc_t (lnk_file (getattr read)))

    - path: /etc/sudoers.d/90-admin
      mode: 0440
      contents:
        inline: |
          admin ALL=(ALL) NOPASSWD: ALL

systemd:
  units:
    - name: var-mnt-swarm.mount
      enabled: true
      contents: |
        [Unit]
        Description=Docker Swarm persistent data

        [Mount]
        What=swarm
        Where=/var/mnt/swarm
        Type=virtiofs
        Options=rw,context=system_u:object_r:container_file_t:s0

        [Install]
        WantedBy=local-fs.target

    - name: docker.service
      dropins:
        - name: 10-swarm.conf
          contents: |
            [Unit]
            RequiresMountsFor=/var/mnt/swarm
            Requires=container-host-access-selinux.service
            After=container-host-access-selinux.service

    - name: container-host-access-selinux.service
      contents: |
        [Unit]
        Description=Allow containers to access required host interfaces

        [Service]
        Type=oneshot
        ExecStart=/usr/sbin/semodule -i /etc/selinux/local/container-host-access.cil
        RemainAfterExit=yes
