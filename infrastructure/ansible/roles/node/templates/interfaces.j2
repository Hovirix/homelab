auto lo
iface lo inet loopback

iface {{ node.network_interface }} inet manual

auto vmbr0
iface vmbr0 inet manual
    bridge-ports {{ node.network_interface }}
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids {{ node.networking.allowed_vlans | map(attribute='id') | map('string') | join(' ') }}

auto vmbr0.{{ node.networking.management.vlan }}
iface vmbr0.{{ node.networking.management.vlan }} inet static
    address {{ node.management_address }}
    gateway {{ node.networking.management.gateway }}
