#!/usr/bin/env bash
{% raw %}
# Logical dumps of every v1 PostgreSQL database for off-site backup.
#
# Borgmatic runs this as a before_backup hook on PVE. PVE cannot reach the
# Swarm-only PostgreSQL service, so dumps come from a transient server
# started on a ZFS clone with trust auth: the snapshot is atomic, the clone
# has no writers, and live data is never touched.

set -euo pipefail

databases=(authentik paperless)
dataset='rpool/swarm/postgres'
dump_dir='/rpool/swarm/postgres/dumps'
dump_parent='/rpool/swarm/postgres'
clone='rpool/pg-dump-clone'
clone_mount='/var/lib/pg-dump-clone'
pg_bin='/usr/lib/postgresql/18/bin'
sockdir="$(mktemp -d /tmp/pg-dump-XXXXXX)"
tmpdump=''
olddump=''
stamp="$(date -u +%Y-%m-%d_%H-%M-%S)"
snapshot="$dataset@pgdump-$stamp"
pgdata="$clone_mount/pgdata"
data_uid="$(stat -c %u /rpool/swarm/postgres/pgdata)"
data_gid="$(stat -c %g /rpool/swarm/postgres/pgdata)"

cleanup() {
  result=0
  if [[ -f "$pgdata/postmaster.pid" ]]; then
    setpriv --reuid="$data_uid" --regid="$data_gid" --clear-groups "$pg_bin/pg_ctl" -D "$pgdata" -m fast stop >/dev/null 2>&1 || result=1
  fi
  if zfs list -H -o name "$clone" >/dev/null 2>&1; then
    zfs unmount "$clone" >/dev/null 2>&1 || result=1
    zfs destroy "$clone" >/dev/null 2>&1 || result=1
  fi
  if zfs list -H -t snapshot -o name "$snapshot" >/dev/null 2>&1; then
    zfs destroy "$snapshot" >/dev/null 2>&1 || result=1
  fi
  rm -rf "$sockdir" || result=1
  [[ -z "$tmpdump" ]] || rm -rf "$tmpdump" || result=1
  if [[ -n "$olddump" && -d "$olddump" ]]; then
    if [[ -d "$dump_dir" ]]; then
      rm -rf "$olddump" || result=1
    else
      mv "$olddump" "$dump_dir" || result=1
    fi
  fi
  rmdir "$clone_mount" >/dev/null 2>&1 || result=1
  return "$result"
}
cleanup_on_exit() {
  result=$?
  trap - EXIT
  cleanup || result=1
  exit "$result"
}
trap cleanup_on_exit EXIT

# Do not hide failed cleanup of a prior clone: startup must not use stale state.
if zfs list -H -o name "$clone" >/dev/null 2>&1; then
  zfs unmount "$clone" || exit 1
  zfs destroy "$clone" || exit 1
fi
mapfile -t stale < <(zfs list -H -t snapshot -o name "$dataset" | awk -F@ '$2 ~ /^pgdump-/')
if ((${#stale[@]} > 0)); then
  zfs destroy "${stale[@]}"
fi

install -d -m 0700 -o root -g root "$dump_dir"
chown "$data_uid:$data_gid" "$sockdir"

zfs snapshot "$snapshot"
zfs clone -o mountpoint="$clone_mount" "$snapshot" "$clone"
tmpdump="$(mktemp -d "$dump_parent/.dumps-XXXXXX")"

rm -f "$pgdata/postmaster.pid"
chmod 0700 "$pgdata"
mv "$pgdata/postgresql.auto.conf" "$pgdata/postgresql.auto.conf.orig" >/dev/null 2>&1 || true

cat >"$sockdir/pg_hba.conf" <<'EOF'
local all all trust
EOF
chown "$data_uid:$data_gid" "$sockdir/pg_hba.conf"
chmod 0600 "$sockdir/pg_hba.conf"

cat >"$sockdir/postgresql.conf" <<EOF
data_directory = '$pgdata'
hba_file = '$sockdir/pg_hba.conf'
listen_addresses = ''
unix_socket_directories = '$sockdir'
shared_buffers = '256MB'
max_connections = 10
EOF
chown "$data_uid:$data_gid" "$sockdir/postgresql.conf"

if ! setpriv --reuid="$data_uid" --regid="$data_gid" --clear-groups "$pg_bin/pg_ctl" -D "$pgdata" -o "-c config_file=$sockdir/postgresql.conf" -l "$sockdir/server.log" -w -t 120 start; then
  cat "$sockdir/server.log" >&2 || true
  exit 1
fi

"$pg_bin/pg_dumpall" --host="$sockdir" --username=postgres --globals-only --file="$tmpdump/globals.sql"
for db in "${databases[@]}"; do
  "$pg_bin/pg_dump" --host="$sockdir" --username=postgres --format=custom --file="$tmpdump/$db.dump" "$db"
done
chmod 0600 "$tmpdump"/*
olddump="$dump_parent/.dumps-old-$stamp"
mv "$dump_dir" "$olddump"
if mv "$tmpdump" "$dump_dir"; then
  tmpdump=''
  rm -rf "$olddump"
  olddump=''
else
  mv "$olddump" "$dump_dir"
  olddump=''
  exit 1
fi
{% endraw %}
