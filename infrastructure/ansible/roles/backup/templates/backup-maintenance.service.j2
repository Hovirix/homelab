[Unit]
Description=Maintain off-site Borg repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=12h
TimeoutStartFailureMode=kill
TimeoutStopSec=30s
TimeoutStopFailureMode=kill
SuccessExitStatus=75
ExecStart=/usr/bin/flock -n -E 75 /run/borgmatic.lock /bin/sh -c '/usr/bin/borgmatic prune && /usr/bin/borgmatic compact && /usr/bin/borgmatic check --force'
