#!/usr/bin/env bash
{% raw %}
set -euo pipefail
umask 077

mode="${1:?usage: restore local DATASET SNAPSHOT LABEL|offsite ARCHIVE LABEL DATASET...|extract ARCHIVE LABEL DATASET}"
parent='rpool/swarm'

restore_local() {
  local dataset="${1:?Pass one dataset}" snapshot="${2:?Pass one snapshot}" point="${3:?Pass its timestamp}" confirmation
  (( $# == 3 )) || return 1
  validate_target "$dataset"
  [[ $snapshot == "$parent/$dataset@"* ]] || return 1
  [[ $(zfs list -H -t snapshot -o name "$snapshot") == "$snapshot" ]] || return 1

  printf '\nLOCAL ROLLBACK\nDataset:  %s\nSnapshot: %s\n\n' "$dataset" "$point"
  printf 'Deletes newer data AND snapshots.\n'
  printf 'Keep services stopped and deployments paused.\n\n'
  read -r -p 'Type ROLLBACK to confirm: ' confirmation
  [[ $confirmation == ROLLBACK ]] || exit 1
  zfs rollback -r "$snapshot"
  printf '\nRollback complete.\nNext: start affected services and verify.\n'
}

validate_target() {
  local dataset="$1"
  [[ $dataset =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] &&
    [[ $(zfs get -H -o value mounted "$parent/$dataset") == yes ]] &&
    [[ $(zfs get -H -o value mountpoint "$parent/$dataset") == "/$parent/$dataset" ]] &&
    [[ $(realpath -e "/$parent/$dataset") == "/$parent/$dataset" ]] || {
      printf 'Dataset invalid or unmounted: %s\n' "$dataset" >&2
      return 1
    }
}

restore_offsite() {
  local archive="${1:?Pass one archive}" point="${2:?Pass its timestamp}" dataset dataset_listing destination confirmation index
  local -a datasets available destinations=()
  shift 2
  datasets=("$@")
  (( ${#datasets[@]} )) || { printf 'Pass at least one dataset.\n' >&2; return 1; }
  [[ $mode != extract || ${#datasets[@]} == 1 ]] || return 1
  if [[ $mode == offsite ]]; then
    for dataset in "${datasets[@]}"; do
      validate_target "$dataset"
    done
  fi

  dataset_listing="$(mktemp)"
  if ! borgmatic --no-color --verbosity -1 list --archive "$archive" --short >"$dataset_listing"; then
    rm -f "$dataset_listing"
    return 1
  fi
  mapfile -t available < <(awk -F/ '$1 == "rpool" && $2 == "swarm" && NF >= 3 { print $3 }' "$dataset_listing" | sort -u)
  rm -f "$dataset_listing"
  for dataset in "${datasets[@]}"; do
    [[ $dataset =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || return 1
    if ! printf '%s\n' "${available[@]}" | grep -Fxq -- "$dataset"; then
      printf 'Dataset %s not in archive %s.\n' "$dataset" "$archive" >&2
      return 1
    fi
  done

  borgmatic --no-color --verbosity -1 check --only data --match-archives "$archive" --force
  printf 'Checking backup... OK\n'
  for dataset in "${datasets[@]}"; do
    destination="$(mktemp -d "/rpool/restore/$dataset-$(date -u +%Y-%m-%d_%H-%M-%S)-XXXXXX")"
    if ! borgmatic --no-color --verbosity -1 extract \
      --archive "$archive" \
      --path "$parent/$dataset" \
      --destination "$destination" \
      --strip-components 2; then
      printf 'Extraction failed. Partial files: %s\n' "$destination" >&2
      return 1
    fi
    destination="$destination/$dataset"
    if [[ ! -d $destination || -L $destination || -z $(find "$destination" -mindepth 1 -print -quit) ]]; then
      printf 'No files extracted: %s\n' "$destination" >&2
      return 1
    fi
    destinations+=("$destination")
    printf 'Extracting %s... OK\n' "$dataset"
  done
  if [[ $mode == extract ]]; then
    printf '\nExtraction complete.\nFiles: %s\n\nLive data unchanged.\n' "${destinations[0]}"
    return 0
  fi

  printf '\nOFF-SITE RESTORE\nDataset: %s\nBackup:  %s\n' "${datasets[*]}" "$point"
  for index in "${!datasets[@]}"; do
    printf 'Target:  /%s/%s\n' "$parent" "${datasets[index]}"
  done
  printf '\n'
  printf 'Overwrites live files.\nDeletes files absent from the backup.\n'
  printf 'Datasets restore one at a time; failure may leave partial data.\n'
  printf 'Keep services stopped and deployments paused.\n\n'
  read -r -p 'Type RESTORE to confirm: ' confirmation
  [[ $confirmation == RESTORE ]] || return 1
  for index in "${!datasets[@]}"; do
    dataset="${datasets[index]}"
    validate_target "$dataset"
    rsync -aHAX --checksum --numeric-ids --delete --exclude=/.zfs/ -- "${destinations[index]}/" "/$parent/$dataset/"
  done
  printf '\nRestore complete.\nNext: start affected services and verify.\n'
}

case "$mode" in
  local) restore_local "${@:2}" ;;
  offsite | extract) restore_offsite "${@:2}" ;;
  *)
    printf 'usage: %s local DATASET SNAPSHOT LABEL|offsite ARCHIVE LABEL DATASET...|extract ARCHIVE LABEL DATASET\n' "$0" >&2
    exit 2
    ;;
esac
{% endraw %}
