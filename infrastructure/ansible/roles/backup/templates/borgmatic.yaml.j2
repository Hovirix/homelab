source_directories:
  - /rpool/swarm/paperless
  - /rpool/swarm/postgres
  - /rpool/swarm/vaultwarden

repositories:
  - path: ssh://u683062-sub1@u683062.your-storagebox.de:23/./homelab

remote_path: borg-1.4
ssh_command: >-
  sshpass -f /etc/borgmatic/storagebox-password
  ssh -o StrictHostKeyChecking=accept-new

encryption_passcommand: cat /etc/borgmatic/passphrase

keep_daily: 7
keep_weekly: 4
keep_monthly: 12

zfs:

loki:
  url: https://loki.hovirix.dev/loki/api/v1/push
  labels:
    app: borgmatic
    hostname: "{{ inventory_hostname }}"
    config: __config
{% if backup_borgmatic_version.stdout is version('2.1.0', '>=') %}
  send_logs: true
{% endif %}

# Generic monitoring success also covers prune/check, not just archive creation.
{% if backup_borgmatic_version.stdout is version('2.0.3', '>=') %}
commands:
  - after: action
    when: [create]
    states: [finish]
    run:
      - echo borgmatic_archive_created
{% else %}
after_backup:
  - echo borgmatic_archive_created
{% endif %}
