#!/usr/bin/env bash
set -euo pipefail

if ! usage=$(sshpass -f /etc/borgmatic/storagebox-password \
  ssh -p 23 -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
  -o ServerAliveInterval=10 -o ServerAliveCountMax=3 \
  u683062-sub1@u683062.your-storagebox.de df -m); then
  printf 'WARNING: Storage Box capacity check failed\n'
  exit 0
fi

if ! capacity=$(printf '%s\n' "$usage" | awk '
  NR > 1 && $4 ~ /^-?[0-9]+$/ && $5 ~ /^[0-9]+%$/ {
    sub(/%$/, "", $5)
    if (!found || $5 + 0 > used) { used = $5 + 0; available = $4 }
    found = 1
  }
  END { if (found) print used, available; else exit 1 }
'); then
  printf 'WARNING: Storage Box capacity output was not recognized\n'
  exit 0
fi

read -r used available <<<"$capacity"
if (( used >= 80 )); then printf 'WARNING: '; fi
printf 'Storage Box capacity: used_percent=%s available_mib=%s\n' "$used" "$available"
