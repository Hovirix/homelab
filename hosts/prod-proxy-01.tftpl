variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBjCf1PpvoMshFkoyjFOYUJ6/pLexwEFqr29COJawkoB"

storage:
  filesystems:
    - device: /dev/disk/by-id/scsi-prod-proxy-01-data
      format: xfs
      path: /var/lib/proxy-data
      with_mount_unit: true

  directories:
    - path: /var/lib/proxy-data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/proxy-data/caddy
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/proxy-data/caddy/data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/proxy-data/caddy/config
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/home/core/.config/containers/systemd
      mode: 0755
      user:
        name: core
      group:
        name: core

  files:
    - path: /etc/zincati/config.d/90-update-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "UTC"

          [[updates.periodic.window]]
          days = ["Sat", "Sun"]
          start_time = "23:30"
          length_minutes = 60

          [[updates.periodic.window]]
          days = ["Wed"]
          start_time = "01:00"
          length_minutes = 30

    - path: /var/home/core/.config/containers/systemd/Caddyfile
      mode: 0644
      contents:
        inline: |
          {
              admin off
              email hovirix@tutanota.com
              acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
          }

          (security_headers) {
              header {
                  X-Content-Type-Options nosniff
                  X-Frame-Options DENY
                  Referrer-Policy strict-origin-when-cross-origin
                  Permissions-Policy "geolocation=(), microphone=(), camera=()"
              }
          }

          authentik.home.hovirix.dev {
              encode zstd gzip
              import security_headers
              reverse_proxy http://authentik.home.hovirix.dev:9000
          }

          vaultwarden.home.hovirix.dev {
              encode zstd gzip
              import security_headers
              reverse_proxy http://vaultwarden.home.hovirix.dev:8000
          }

          immich.home.hovirix.dev {
              encode zstd gzip
              import security_headers
              reverse_proxy http://immich.home.hovirix.dev:2283
          }

          grafana.home.hovirix.dev {
              encode zstd gzip
              import security_headers
              reverse_proxy http://grafana.home.hovirix.dev:3000
          }

          paperless.home.hovirix.dev {
              encode zstd gzip
              import security_headers

              handle_path /admin* {
                  respond 403
              }

              reverse_proxy http://paperless.home.hovirix.dev:8000
          }

    - path: /var/home/core/.config/containers/systemd/caddy.container
      mode: 0644
      contents:
        inline: |
          [Container]
          Image=docker.io/caddybuilds/caddy-cloudflare@sha256:d81ee34d06745f8e34e647519820a7c2f8e0d6901641b6df40e85e1f376e5dec

          Network=host

          Environment=CLOUDFLARE_API_TOKEN=${caddy_cloudflare_dns_token}

          Volume=./Caddyfile:/etc/caddy/Caddyfile:ro,Z
          Volume=/var/lib/proxy-data/caddy/data:/data:Z
          Volume=/var/lib/proxy-data/caddy/config:/config:Z

          [Service]
          MemoryMax=512M
          TasksMax=2048
          LimitNOFILE=262144
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target
