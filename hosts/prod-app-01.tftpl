variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBjCf1PpvoMshFkoyjFOYUJ6/pLexwEFqr29COJawkoB"

storage:
  filesystems:
    - device: /dev/disk/by-id/scsi-prod-app-01-data
      format: xfs
      path: /var/lib/app-data
      with_mount_unit: true

  directories:
    - path: /var/lib/app-data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/vaultwarden
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/immich
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/immich/ml-cache
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/media
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/export
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/consume
      mode: 0755
      user:
        name: core
      group:
        name: core

  files:
    - path: /etc/zincati/config.d/90-update-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "UTC"

          [[updates.periodic.window]]
          days = ["Sat", "Sun"]
          start_time = "23:30"
          length_minutes = 60

          [[updates.periodic.window]]
          days = ["Wed"]
          start_time = "01:00"
          length_minutes = 30

    - path: /var/home/core/.config/containers/systemd/vaultwarden.container
      mode: 0644
      contents:
        inline: |
          [Container]
          Image=ghcr.io/dani-garcia/vaultwarden@sha256:1ca2e2098ba9ab9e46004f4ee61a3be6080ffee3ed41018a95c4b0fb6454a54b

          Network=host

          Environment=DOMAIN=https://vault.home.hovirix.com
          Environment=SIGNUPS_ALLOWED=false
          Environment=LOG_LEVEL=warn
          Environment=ROCKET_WORKERS=10
          Environment=PUSH_ENABLED=true
          Environment=PUSH_INSTALLATION_ID=${installation_id}
          Environment=PUSH_INSTALLATION_KEY=${installation_key}
          Environment=PUSH_RELAY_URI=https://api.bitwarden.eu
          Environment=PUSH_IDENTITY_URI=https://identity.bitwarden.eu
          Environment=DATABASE_URL=postgresql://vaultwarden:${postgres_vaultwarden_password}@postgres.home.hovirix.com/vaultwarden

          Volume=/var/lib/app-data/vaultwarden:/data:Z

          [Service]
          MemoryMax=512M
          TasksMax=1024
          LimitNOFILE=262144
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target

    - path: /var/home/core/.config/containers/systemd/immich-machine-learning.container
      mode: 0644
      contents:
        inline: |
          [Container]
          Image=ghcr.io/immich-app/immich-machine-learning@sha256:b213fa3c82d27a21a299c46ffbb38a091f18384db1ad67d409a3b34fe0fce556

          Network=host

          Volume=/var/lib/app-data/immich/ml-cache:/cache:Z

          [Service]
          MemoryMax=6G
          TasksMax=4096
          LimitNOFILE=1048576
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target

    - path: /var/home/core/.config/containers/systemd/immich-server.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          After=immich-machine-learning.service
          Wants=immich-machine-learning.service

          [Container]
          Image=ghcr.io/immich-app/immich-server@sha256:8b14246ee4c53e39191a54279f8c72f3eed3c026c5b23d0f7e4ab5e69e3aac4a

          Network=host

          Environment=DB_USERNAME=immich
          Environment=DB_DATABASE_NAME=immich
          Environment=DB_PASSWORD=${postgres_immich_password}
          Environment=DB_VECTOR_EXTENSION=pgvector
          Environment=DB_HOSTNAME=postgres.home.hovirix.com
          Environment=REDIS_HOSTNAME=valkey.home.hovirix.com

          Volume=/var/lib/app-data/immich:/usr/src/app/upload:Z

          [Service]
          MemoryMax=6G
          TasksMax=4096
          LimitNOFILE=1048576
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target

    - path: /var/home/core/.config/containers/systemd/paperless-ngx.container
      mode: 0644
      contents:
        inline: |
          [Container]
          Image=ghcr.io/paperless-ngx/paperless-ngx@sha256:7b937cb2fa2885ab0ecfceb8c7e8827e2312472d9d897a270097ba7f5522dcdc

          Network=host

          Environment=PAPERLESS_REDIS=redis://valkey.home.hovirix.com:6379
          Environment=PAPERLESS_DBHOST=postgres.home.hovirix.com
          Environment=PAPERLESS_DBNAME=paperless
          Environment=PAPERLESS_DBUSER=paperless
          Environment=PAPERLESS_DBPASS=${postgres_paperless_password}
          Environment=PAPERLESS_SECRET_KEY=${paperless_secret_key}
          Environment=PAPERLESS_URL=https://paperless.home.hovirix.com

          Environment=PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
          Environment=PAPERLESS_SOCIAL_AUTO_SIGNUP=true
          Environment=PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
          Environment=PAPERLESS_DISABLE_REGULAR_LOGIN=true
          Environment=PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
          Environment=PAPERLESS_LOGOUT_REDIRECT_URL=https://authentik.home.hovirix.site/application/o/paperless/end-session/

          Environment=PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"authentik","name":"authentik","client_id":"${paperless_client_id}","secret":"${paperless_client_secret}","settings":{"server_url":"https://authentik.home.hovirix.site/application/o/<application_slug>/.well-known/openid-configuration","fetch_userinfo":true}}],"SCOPE":["openid","profile","email"]}}

          Volume=/var/lib/app-data/paperless/data:/usr/src/paperless/data:Z
          Volume=/var/lib/app-data/paperless/media:/usr/src/paperless/media:Z
          Volume=/var/lib/app-data/paperless/export:/usr/src/paperless/export:Z
          Volume=/var/lib/app-data/paperless/consume:/usr/src/paperless/consume:Z

          [Service]
          MemoryMax=2G
          TasksMax=2048
          LimitNOFILE=262144
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target
