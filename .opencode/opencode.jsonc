{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "sops": "deny",
      "sops *": "deny",
    }
  },

  "mcp": {
    "docker-docs": {
      "type": "remote",
      "url": "https://mcp-docs.docker.com/mcp",
      "enabled": true
    },

    "netdata": {
      "type": "remote",
      "url": "https://netdata.hovirix.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:NETDATA_MCP_TOKEN}"
      },
      "enabled": true
    }
  }
}
