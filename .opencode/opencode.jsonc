{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "sops": "deny",
      "sops *": "deny",
      "task services:secret:sync*": "deny",
      "*operations/scripts/secrets.py*": "deny",
    },
  },


  "mcp": {
    "grafana": {
      "enabled": true,
      "type": "local",
      "command": [
        "secretspec",
        "run",
        "-P",
        "production",
        "-S",
        "opencode",
        "--reason",
        "provide read-only Grafana observability access to OpenCode",
        "--",
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana:1.2.0",
        "-t",
        "stdio",
        "--disable-write"
      ],
      "environment": {
        "GRAFANA_URL": "https://grafana.hovirix.dev"
      }
    }
  }
}
