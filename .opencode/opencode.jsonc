{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "plan": {
      "model": "openai/gpt-5.5"
    },
    "build": {
      "model": "openai/gpt-5.4-mini-fast"
    }
  },

  "permission": {

    "edit": {
      "*": "allow",
      "secrets/**": "deny",
    },

    "bash": {
      "age *": "deny",
      "ssh *": "deny",
      "sops *": "deny",
    },
  }
}
