[Container]
Image=docker.io/caddybuilds/caddy-cloudflare:2.11.2@sha256:d81ee34d06745f8e34e647519820a7c2f8e0d6901641b6df40e85e1f376e5dec

Secret=caddy_cloudflare_dns_token,type=env,target=CLOUDFLARE_API_TOKEN

Network=host

Volume=./Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=caddy-data.volume:/data:Z
Volume=caddy-config.volume:/config:Z

[Service]
MemoryMax=512M
TasksMax=2048
LimitNOFILE=262144
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
