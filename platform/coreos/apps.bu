variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBjCf1PpvoMshFkoyjFOYUJ6/pLexwEFqr29COJawkoB"

storage:
  filesystems:
    - device: /dev/disk/by-id/scsi-prod-app-01-data
      format: xfs
      path: /var/lib/app-data
      with_mount_unit: true

  directories:
    - path: /var/lib/app-data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/vaultwarden
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/immich
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/immich/ml-cache
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/data
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/media
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/export
      mode: 0755
      user:
        name: core
      group:
        name: core

    - path: /var/lib/app-data/paperless/consume
      mode: 0755
      user:
        name: core
      group:
        name: core

  files:
    - path: /etc/zincati/config.d/90-update-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "UTC"

          [[updates.periodic.window]]
          days = ["Sat", "Sun"]
          start_time = "23:30"
          length_minutes = 60

          [[updates.periodic.window]]
          days = ["Wed"]
          start_time = "01:00"
          length_minutes = 30

    - path: /var/home/core/.config/containers/systemd/vaultwarden.container
      mode: 0644
      contents:
        local: "../../workloads/apps/vaultwarden/vaultwarden.container"

    - path: /var/home/core/.config/containers/systemd/vaultwarden.env
      mode: 0644
      contents:
        local: "../../workloads/apps/vaultwarden/vaultwarden.env"

    - path: /var/home/core/.config/containers/systemd/immich-machine-learning.container
      mode: 0644
      contents:
        local: "../../workloads/apps/immich/immich-machine-learning.container"

    - path: /var/home/core/.config/containers/systemd/immich-server.container
      mode: 0644
      contents:
        local: "../../workloads/apps/immich/immich-server.container"

    - path: /var/home/core/.config/containers/systemd/immich.env
      mode: 0644
      contents:
        local: "../../workloads/apps/immich/immich.env"

    - path: /var/home/core/.config/containers/systemd/paperless-ngx.container
      mode: 0644
      contents:
        local: "../../workloads/apps/paperless/paperless.container"

    - path: /var/home/core/.config/containers/systemd/paperless.env
      mode: 0644
      contents:
        local: "../../workloads/apps/paperless/paperless.env"
