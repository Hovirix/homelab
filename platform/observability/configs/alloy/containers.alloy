// METRICS — Containers / cAdvisor

prometheus.exporter.cadvisor "containers" {
	containerd_host      = "/rootfs/run/containerd/containerd.sock"
	containerd_namespace = "moby"

	// Host metrics belong to exporter.unix.
	docker_only               = true
	disable_root_cgroup_stats = true
	store_container_labels    = false

	allowlisted_container_labels = [
		"com.docker.swarm.service.name",
		"com.docker.swarm.task.name",
	]

	enabled_metrics = [
		"cpu",
		"memory",
		"network",
		"disk",
		"diskIO",
		"oom_event",
	]
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	forward_to      = [prometheus.relabel.containers.receiver]
	scrape_interval = "15s"
}

prometheus.relabel "containers" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		action        = "keep"
		source_labels = ["container_label_com_docker_swarm_service_name"]
		regex         = ".+"
	}

	rule {
		source_labels = ["container_label_com_docker_swarm_service_name"]
		target_label  = "service"
	}

	// Stable Swarm replica slot.
	rule {
		source_labels = ["container_label_com_docker_swarm_task_name"]
		regex         = ".*[.]([0-9]+)[.][^.]+$"
		replacement   = "${1}"
		target_label  = "replica"
	}

	rule {
		replacement  = sys.env("ALLOY_NODE")
		target_label = "node"
	}

	rule {
		replacement  = "cadvisor"
		target_label = "job"
	}

	// Remove ephemeral/redundant container identity.
	rule {
		action = "labeldrop"
		regex  = "(container|container_label_.+|id|image|instance|name)"
	}
}
