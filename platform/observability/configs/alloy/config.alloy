logging {
	level  = "info"
	format = "logfmt"
}

// =============================================================================
// LOGS — Docker / Swarm
// =============================================================================

discovery.docker "local" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
	targets = discovery.docker.local.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		target_label  = "service_name"
	}
}

loki.source.docker "local" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker_logs.output
	forward_to = [loki.write.default.receiver]
}

// =============================================================================
// LOGS — systemd journal
// =============================================================================

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "priority"
	}

	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "hostname"
	}
}

loki.source.journal "system" {
	max_age       = "24h"
	relabel_rules = loki.relabel.journal.rules
	labels        = { job = "systemd-journal" }
	forward_to    = [loki.write.default.receiver]
}

// =============================================================================
// LOGS — Loki
// =============================================================================

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// =============================================================================
// METRICS — Containers / cAdvisor
// =============================================================================

prometheus.exporter.cadvisor "containers" {
	// Host metrics belong to exporter.unix.
	docker_only               = true
	disable_root_cgroup_stats = true
	store_container_labels    = false

	allowlisted_container_labels = [
		"com.docker.swarm.service.name",
		"com.docker.swarm.task.name",
	]

	enabled_metrics = [
		"cpu",
		"memory",
		"network",
		"disk",
		"diskIO",
		"oom_event",
	]
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	forward_to      = [prometheus.relabel.containers.receiver]
	scrape_interval = "15s"
}

prometheus.relabel "containers" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		action        = "keep"
		source_labels = ["container_label_com_docker_swarm_service_name"]
		regex         = ".+"
	}

	rule {
		source_labels = ["container_label_com_docker_swarm_service_name"]
		target_label  = "service"
	}

	// Stable Swarm replica slot.
	rule {
		source_labels = ["container_label_com_docker_swarm_task_name"]
		regex         = ".*[.]([0-9]+)[.][^.]+$"
		replacement   = "${1}"
		target_label  = "replica"
	}

	rule {
		replacement  = sys.env("ALLOY_NODE")
		target_label = "node"
	}

	rule {
		replacement  = "cadvisor"
		target_label = "job"
	}

	// Remove ephemeral/redundant container identity.
	rule {
		action = "labeldrop"
		regex  = "(container|container_label_.+|id|image|instance|name)"
	}
}

// =============================================================================
// METRICS — Host / Unix
// =============================================================================

prometheus.exporter.unix "host" {
	rootfs_path = "/host/root"
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"

	set_collectors = [
		// Compute.
		"cpu",
		"meminfo",
		"loadavg",
		"pressure",

		// Storage.
		"filesystem",
		"diskstats",

		// Network.
		"netdev",
		"netstat",
		"conntrack",
		"sockstat",

		// Kernel.
		"vmstat",
		"stat",
		"filefd",

		// Host identity.
		"os",
		"uname",

		// Clock.
		"time",
		"timex",
	]

	filesystem {
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
	}

	netdev {
		device_exclude = "^(lo|veth.+|docker.+|br-.+)$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	forward_to      = [prometheus.relabel.host.receiver]
	scrape_interval = "15s"
}

prometheus.relabel "host" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		replacement  = sys.env("ALLOY_NODE")
		target_label = "node"
	}

	rule {
		replacement  = "node"
		target_label = "job"
	}

	// node is the canonical host identity.
	rule {
		action = "labeldrop"
		regex  = "instance"
	}
}

// =============================================================================
// METRICS — Traefik
// =============================================================================

discovery.relabel "traefik" {
	targets = discovery.docker.local.targets

	rule {
		action        = "keep"
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "traefik_proxy"
	}

	rule {
		source_labels = ["__meta_docker_network_ip"]
		regex         = "(.+)"
		replacement   = "${1}:8082"
		target_label  = "__address__"
	}
}

prometheus.scrape "traefik" {
	targets         = discovery.relabel.traefik.output
	forward_to      = [prometheus.relabel.traefik.receiver]
	scrape_interval = "15s"
}

prometheus.relabel "traefik" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		replacement  = "traefik"
		target_label = "job"
	}

	rule {
		action = "labeldrop"
		regex  = "instance"
	}
}

// =============================================================================
// METRICS — VictoriaMetrics
// =============================================================================

prometheus.remote_write "default" {
	endpoint {
		url = "http://victoriametrics:8428/api/v1/write"
	}
}
