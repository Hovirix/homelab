// METRICS — HTTPS availability through internal Traefik routing

prometheus.exporter.blackbox "services" {
	config_file = "/etc/alloy/blackbox.yml"

	target {
		name    = "immich_public"
		address = "https://immich.hovirix.dev/api/server/ping"
		module  = "http_2xx"
		labels  = {service = "immich", path = "public"}
	}

	target {
		name    = "grafana_public"
		address = "https://grafana.hovirix.dev/api/health"
		module  = "http_2xx"
		labels  = {service = "grafana", path = "public"}
	}

	target {
		name    = "authentik_public"
		address = "https://authentik.hovirix.dev/-/health/ready/"
		module  = "http_2xx"
		labels  = {service = "authentik", path = "public"}
	}

	target {
		name    = "vaultwarden_public"
		address = "https://vaultwarden.hovirix.dev/alive"
		module  = "http_2xx"
		labels  = {service = "vaultwarden", path = "public"}
	}

	target {
		name    = "miniflux_public"
		address = "https://miniflux.hovirix.dev/healthcheck"
		module  = "http_2xx"
		labels  = {service = "miniflux", path = "public"}
	}

	target {
		name    = "paperless_public"
		address = "https://paperless.hovirix.dev/accounts/login/"
		module  = "http_2xx"
		labels  = {service = "paperless", path = "public"}
	}

	target {
		name    = "immich"
		address = "https://traefik_proxy:443/api/server/ping"
		module  = "http_2xx"
		labels  = {service = "immich"}
	}

	target {
		name    = "grafana"
		address = "https://traefik_proxy:443/api/health"
		module  = "http_2xx"
		labels  = {service = "grafana"}
	}

	target {
		name    = "authentik"
		address = "https://traefik_proxy:443/-/health/ready/"
		module  = "http_2xx"
		labels  = {service = "authentik"}
	}

	target {
		name    = "vaultwarden"
		address = "https://traefik_proxy:443/alive"
		module  = "http_2xx"
		labels  = {service = "vaultwarden"}
	}

	target {
		name    = "miniflux"
		address = "https://traefik_proxy:443/healthcheck"
		module  = "http_2xx"
		labels  = {service = "miniflux"}
	}

	target {
		name    = "paperless"
		address = "https://traefik_proxy:443/accounts/login/"
		module  = "http_2xx"
		labels  = {service = "paperless"}
	}
}

discovery.relabel "blackbox" {
	targets = prometheus.exporter.blackbox.services.targets

	rule {
		source_labels = ["path"]
		regex         = ""
		replacement   = "internal"
		target_label  = "path"
	}

	// Blackbox uses hostname for both the HTTP Host header and TLS SNI.
	rule {
		source_labels = ["service"]
		replacement   = "${1}.hovirix.dev"
		target_label  = "__param_hostname"
	}
}

prometheus.scrape "blackbox" {
	targets         = discovery.relabel.blackbox.output
	forward_to      = [prometheus.relabel.blackbox.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "10s"
}

prometheus.relabel "blackbox" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		replacement  = sys.env("ALLOY_NODE")
		target_label = "node"
	}

	rule {
		replacement  = "blackbox"
		target_label = "job"
	}

	rule {
		action = "labeldrop"
		regex  = "instance"
	}
}
