{
  "uid": "openwrt",
  "title": "OpenWrt",
  "description": "Router metrics and system logs. WireGuard handshakes are informational: idle peers need not remain connected. Traffic counters may not include hardware-offloaded flows. Syslog uses TCP without persistent buffering on the router.",
  "tags": ["network", "openwrt"],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        { "refId": "A", "expr": "max(up{job=\"openwrt\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max without (collector) (node_boot_time_seconds{job=\"openwrt\"})",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CPU used",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(max without (collector) (rate(node_cpu_seconds_total{job=\"openwrt\",mode=\"idle\"}[5m]))))",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory used",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - max without (collector) (node_memory_MemAvailable_bytes{job=\"openwrt\"} / node_memory_MemTotal_bytes{job=\"openwrt\"}))",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Interface traffic",
      "description": "Includes physical, VLAN, WAN and VPN interfaces; do not sum overlapping interface counters.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * max without (collector) (rate(node_network_receive_bytes_total{job=\"openwrt\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{device}} RX"
        },
        {
          "refId": "B",
          "expr": "8 * max without (collector) (rate(node_network_transmit_bytes_total{job=\"openwrt\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{device}} TX"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "min": 0 } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Interface errors and drops",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (collector) (rate(node_network_receive_errs_total{job=\"openwrt\"}[$__rate_interval]) + rate(node_network_transmit_errs_total{job=\"openwrt\"}[$__rate_interval]))",
          "legendFormat": "{{device}} errors"
        },
        {
          "refId": "B",
          "expr": "max without (collector) (rate(node_network_receive_drop_total{job=\"openwrt\"}[$__rate_interval]) + rate(node_network_transmit_drop_total{job=\"openwrt\"}[$__rate_interval]))",
          "legendFormat": "{{device}} drops"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Wi-Fi stations",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (collector) (wifi_stations_total{job=\"openwrt\"})",
          "legendFormat": "{{radio}} / {{ifname}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Wi-Fi station signal",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "max without (collector) (wifi_station_signal_dbm{job=\"openwrt\"})",
          "legendFormat": "{{ifname}} / {{mac}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dBm" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "WireGuard peer traffic",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "8 * max without (collector) (rate(wireguard_received_bytes_total{job=\"openwrt\"}[$__rate_interval]))",
          "legendFormat": "{{public_key}} RX"
        },
        {
          "refId": "B",
          "expr": "8 * max without (collector) (rate(wireguard_sent_bytes_total{job=\"openwrt\"}[$__rate_interval]))",
          "legendFormat": "{{public_key}} TX"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps", "min": 0 } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WireGuard last handshake age",
      "description": "Peers with no handshake are omitted. Idle peers may legitimately have old handshakes.",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (max without (collector) (wireguard_latest_handshake_seconds{job=\"openwrt\"}) > 0)",
          "legendFormat": "{{public_key}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conntrack utilization",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "metrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max without (collector) (node_nf_conntrack_entries{job=\"openwrt\"} / node_nf_conntrack_entries_limit{job=\"openwrt\"})",
          "legendFormat": "Used"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Router logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "logs" },
      "targets": [
        { "refId": "A", "expr": "{job=\"openwrt\"}", "queryType": "range" }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
