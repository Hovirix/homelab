{
  "mode": "local",
  "bind": "lan",
  "publicOrigin": "https://openclaw.hovirix.dev",
  "trustedProxies": ["10.254.1.0/24"],
  "auth": {
    "mode": "trusted-proxy",
    "trustedProxy": {
      "userHeader": "x-authentik-username",
      "requiredHeaders": [
        "x-forwarded-proto",
        "x-forwarded-host",
        "x-openclaw-scopes"
      ],
      "deviceAutoApprove": {
        "enabled": true,
        "scopes": [
          "operator.admin",
          "operator.read",
          "operator.write",
          "operator.approvals",
          "operator.questions"
        ]
      }
    }
  },
  "roles": {
    "default": "authentik",
    "definitions": {
      "authentik": {
        "sessions": { "others": "none" },
        "agents": "*",
        "scopes": ["operator.admin"]
      }
    }
  }
}
